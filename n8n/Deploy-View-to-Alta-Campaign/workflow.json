{
  "id": "VIojA84aR72tg7k7",
  "name": "Deploy View to Alta Campaign",
  "nodes": [
    {
      "id": "a01",
      "name": "Deploy Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1400, 200],
      "parameters": {
        "httpMethod": "POST",
        "path": "deploy-view-to-alta",
        "responseMode": "onReceived"
      },
      "webhookId": "b3ac1e6e-alta-door-0000-000000000001",
      "notes": "The door's ONLY entry (ruling 2026-09-03). The daily feed lives in Airtable now, as Schedule Live View Deploys, which creates the launch row and POSTs {recordId} here, so a scheduled deploy and a hand launch are the same run."
    },
    {
      "id": "ad-01-open",
      "name": "Open Deploy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1200, 200],
      "parameters": { "jsCode": "@@file:nodes/Open-Deploy.js" }
    },
    {
      "id": "ad-02-prepare",
      "name": "Prepare",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [-1000, 200],
      "parameters": {
        "workflowId": { "__rl": true, "mode": "id", "value": "VfjJGNlykzuZok2T", "cachedResultName": "Deploy View Prepare and Finish" },
        "workflowInputs": { "mappingMode": "passThrough", "value": {}, "matchingColumns": [], "schema": [] },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      },
      "notes": "Mode prepare, awaited, error left to travel: resolves the launch row into client, base, campaign, mirror row, table, view and the field contract, drops DNC domains, applies the run cap and hands back the prospects shaped as merge variables. A failure inside it fails this run, which is the run the Error Logger names."
    },
    {
      "id": "ad-03-loadstate",
      "name": "Load State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 200],
      "parameters": { "jsCode": "@@file:nodes/Load-State.js" }
    },
    {
      "id": "a21",
      "name": "Any Prospects?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-600, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "p1", "leftValue": "={{ $json._none ? '' : 'x' }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "Nothing to push is not a failure: a refused launch and a view where every row was skipped both go straight to the close, which stamps the rows and writes the row."
    },
    {
      "id": "a22",
      "name": "Push Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-400, 120],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.campaign_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.enroll_body }}",
        "options": {
          "batching": { "batch": { "batchSize": 1, "batchInterval": 8000 } },
          "response": { "response": { "fullResponse": true, "neverError": true } },
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "The one thing this door does that nothing else can: one prospect per request into the campaign's audience webhook, paced at one every 8 seconds (faster bursts draw IP-level 429s)."
    },
    {
      "id": "a23",
      "name": "Collect Push",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 120],
      "parameters": { "jsCode": "@@file:nodes/Collect-Push.js" }
    },
    {
      "id": "a24",
      "name": "RB Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [0, 120],
      "parameters": { "amount": 90, "unit": "seconds" },
      "webhookId": "a1a1a1a1-alta-door-0000-00000000wait"
    },
    {
      "id": "a25",
      "name": "List Campaign Prospects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [200, 120],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.flowroots.com/webhook/alta-list-prospects",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { campaignId: $('Collect Push').first().json.campaignId } }}",
        "options": {
          "response": { "response": { "neverError": true } },
          "timeout": 290000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "a26",
      "name": "Verify Landing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 120],
      "parameters": { "jsCode": "@@file:nodes/Verify-Landing.js" }
    },
    {
      "id": "a27",
      "name": "Any Persons?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "q1", "leftValue": "={{ ($json.personIds||[]).length ? 'x' : '' }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a28",
      "name": "Fetch Persons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [800, 40],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.flowroots.com/webhook/alta-persons",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { personIds: $json.personIds } }}",
        "options": {
          "response": { "response": { "neverError": true } },
          "timeout": 290000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "a29",
      "name": "Title Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 40],
      "parameters": { "jsCode": "@@file:nodes/Title-Gate.js" }
    },
    {
      "id": "a30",
      "name": "Any Pauses?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 40],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "w1", "leftValue": "={{ $json._none ? '' : 'x' }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a31",
      "name": "Pause Mismatches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1400, -40],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.flowroots.com/webhook/alta-pause-prospects",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { prospectIds: $json.prospectIds, action: \"pause\" } }}",
        "options": {
          "response": { "response": { "neverError": true } },
          "timeout": 290000
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "id": "ad-90-close",
      "name": "Close Deploy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 200],
      "parameters": { "jsCode": "@@file:nodes/Close-Deploy.js" }
    },
    {
      "id": "ad-91-finish",
      "name": "Finish",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [1800, 200],
      "parameters": {
        "workflowId": { "__rl": true, "mode": "id", "value": "VfjJGNlykzuZok2T", "cachedResultName": "Deploy View Prepare and Finish" },
        "workflowInputs": { "mappingMode": "passThrough", "value": {}, "matchingColumns": [], "schema": [] },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      },
      "notes": "Mode finish, awaited, error left to travel: stamps Deploy Error and the Campaigns links on the source rows, writes the Lead Lists receipt and writes this run's Hub row, upserted on this execution's id. A failed log write crashes it, and with it this run."
    }
  ],
  "connections": {
    "Deploy Webhook": { "main": [[{ "node": "Open Deploy", "type": "main", "index": 0 }]] },
    "Open Deploy": { "main": [[{ "node": "Prepare", "type": "main", "index": 0 }]] },
    "Prepare": { "main": [[{ "node": "Load State", "type": "main", "index": 0 }]] },
    "Load State": { "main": [[{ "node": "Any Prospects?", "type": "main", "index": 0 }]] },
    "Any Prospects?": {
      "main": [
        [{ "node": "Push Prospect", "type": "main", "index": 0 }],
        [{ "node": "Close Deploy", "type": "main", "index": 0 }]
      ]
    },
    "Push Prospect": { "main": [[{ "node": "Collect Push", "type": "main", "index": 0 }]] },
    "Collect Push": { "main": [[{ "node": "RB Wait", "type": "main", "index": 0 }]] },
    "RB Wait": { "main": [[{ "node": "List Campaign Prospects", "type": "main", "index": 0 }]] },
    "List Campaign Prospects": { "main": [[{ "node": "Verify Landing", "type": "main", "index": 0 }]] },
    "Verify Landing": { "main": [[{ "node": "Any Persons?", "type": "main", "index": 0 }]] },
    "Any Persons?": {
      "main": [
        [{ "node": "Fetch Persons", "type": "main", "index": 0 }],
        [{ "node": "Close Deploy", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Persons": { "main": [[{ "node": "Title Gate", "type": "main", "index": 0 }]] },
    "Title Gate": { "main": [[{ "node": "Any Pauses?", "type": "main", "index": 0 }]] },
    "Any Pauses?": {
      "main": [
        [{ "node": "Pause Mismatches", "type": "main", "index": 0 }],
        [{ "node": "Close Deploy", "type": "main", "index": 0 }]
      ]
    },
    "Pause Mismatches": { "main": [[{ "node": "Close Deploy", "type": "main", "index": 0 }]] },
    "Close Deploy": { "main": [[{ "node": "Finish", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "gqm6HzVNzEMQ8Ml0"
  }
}
