              }
            ]
          },
          "options": {
            "pagination": {
              "pagination": {
                "paginationMode": "updateAParameterInEachRequest",
                "parameters": {
                  "parameters": [
                    {
                      "type": "qs",
                      "name": "cursor",
                      "value": "={{ $response.body.next }}"
                    }
                  ]
                },
                "paginationCompleteWhen": "other",
                "completeExpression": "={{ !$response.body.hasMore }}",
                "limitPagesFetched": true,
                "maxRequests": 60,
                "requestInterval": 300
              }
            }
          }
        },
        "credentials": {
          "httpBearerAuth": {
