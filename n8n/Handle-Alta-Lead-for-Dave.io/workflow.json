    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Client Vars').first().json.slackChannel }}"
        },
        "messageType": "block",
        "blocksUi": "={{ (function(){ var F=$('Flatten').first().json; var N=$('Alta Normalize').first().json; var company=F.company_name||'Unknown'; var tz=F.custom_timezone||''; var zmap={ET:'America/New_York',CT:'America/Chicago',MT:'America/Denver',PT:'America/Los_Angeles',AKT:'America/Anchorage',HT:'Pacific/Honolulu'}; var zone=zmap[tz]||'America/New_York'; var localTime=$now.setZone(zone).toFormat('cccc h:mma'); var name=N.full_name; var title=(N.job_title||'').trim(); var contact=N.lead_email||N.linkedin_url||''; var whoParts=[]; if(name)whoParts.push(name); if(title)whoParts.push(title); if(contact)whoParts.push(contact); var who=name?whoParts.join(' · '):('General inbox ('+contact+'), confirm the decision-maker'); var city=(N.city||'').trim(); var where=(city?city+', ':'')+tz+' · now '+localTime; var reply=(F.reply_text||'').replace(/\\s+/g,' ').trim().slice(0,600)||'interested, see thread'; var head='🔥 New interested lead, '+company+'\\nVia: Alta · '+(F.reply_channel||'reply')+'\\nWho: '+who+'\\nWhere: '+where+'\\nTheir reply: '+reply; var brief=(F.custom_qualification_brief||'').slice(0,2900); var t1={type:'mrkdwn',text:head.slice(0,2900)}; var b1={type:'section',text:t1}; var blocks=[b1]; if(brief){ blocks.push({type:'divider'}); var t2={type:'mrkdwn',text:brief}; var b2={type:'section',text:t2}; blocks.push(b2); } return JSON.stringify({blocks:blocks}); })() }}",
        "text": "=New interested lead (Alta): {{ $('Flatten').first().json.company_name }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
