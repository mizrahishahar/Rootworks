        "name": "Fetch Prospects",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          -180,
          0
        ],
        "parameters": {
          "method": "GET",
          "url": "https://api.altahq.com/v1/prospects",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpBearerAuth",
          "sendQuery": true,
          "queryParameters": {
            "parameters": [
              {
