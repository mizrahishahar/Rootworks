{
  "name": "Deploy View Prepare and Finish",
  "nodes": [
    {
      "id": "dvpf-00-trigger",
      "name": "Deploy Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -1400,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      },
      "notes": "One item from a deploy door: {mode, sender, execId, wfId, automation, recordId} for prepare, {mode, sender, execId, wfId, automation, state} for finish. Awaited by both callers, with the error left to travel: a sub-workflow carries no Error Logger and fails into the run that was actually doing the work."
    },
    {
      "id": "dvpf-01-route",
      "name": "Route Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
