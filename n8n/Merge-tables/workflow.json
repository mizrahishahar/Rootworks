              "placeholder": "tblXXXXXXXXXXXXXX — the table to copy FROM",
              "requiredField": true
            },
            {
              "fieldLabel": "Target Table ID",
              "placeholder": "tblXXXXXXXXXXXXXX — the table to copy INTO",
              "requiredField": true
            }
