        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          200
        ],
        "parameters": {
          "jsCode": "// One-off: PATCH records. Body: { base, table, records:[{id, fields}] }. Batches of 10.\nconst b=($input.first().json||{}).body||{};\nif(!b.base||!b.table||!Array.isArray(b.records)||!b.records.length) throw new Error(\"need base, table, records[]\");\nconst out=[]; for(let i=0;i<b.records.length;i+=10) out.push({ json:{ base:b.base, table:b.table, records:b.records.slice(i,i+10) } });\nreturn out;\n"
        }
      },
