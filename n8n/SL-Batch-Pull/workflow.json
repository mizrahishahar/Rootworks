              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.has_next_page }}",
              "limitPagesFetched": true,
              "maxRequests": "={{ Math.max(1, Math.min(Number($json.batchPages) || 10, Math.ceil((Number($json.remaining) || 50) / 50))) }}",
              "requestInterval": 2500
            }
