    {
      "parameters": {
        "formTitle": "Field Merge — attach CSV columns by key",
        "formDescription": "Upload a CSV keyed by Domain or Final Email with any extra columns. Every non-key column is stamped onto all rows of the target table sharing the key value. Additive only: no inserts, no deletes. Every CSV column must already exist on the table: a missing one refuses the run before any write (the scaffold or the Operator adds columns, never this door). Final Email merges are refused on *Domains* tables.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Clayroots Base ID",
              "placeholder": "appXXXXXXXXXXXXXX — from the Hub Clients table",
              "requiredField": true
            },
            {
              "fieldLabel": "Table",
              "placeholder": "People or Companies, blank = People"
            },
            {
              "fieldLabel": "Key column",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Domain"
                  },
                  {
                    "option": "Final Email"
                  }
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Fields to attach",
              "placeholder": "optional, comma-separated CSV columns — empty = every non-key column",
              "requiredField": false
            },
            {
              "fieldLabel": "Domain CSV",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".csv",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "domain-merge",
          "respondWithOptions": {
            "values": {
              "respondWith": "redirect",
              "redirectUrl": "=https://n8n.flowroots.com/workflow/{{ $workflow.id }}/executions/{{ $execution.id }}"
            }
          }
        }
      },
      "id": "548eec0a-1e4c-4674-ac75-4be15abc1a71",
      "name": "Domain Merge Form",
