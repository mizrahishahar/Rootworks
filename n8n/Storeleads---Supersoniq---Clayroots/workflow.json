                  },
                  {
                    "option": "France"
                  },
                  {
                    "option": "Netherlands"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Platforms (tick any; none = all platforms)",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  {
                    "option": "shopify"
                  },
                  {
                    "option": "woocommerce"
                  },
                  {
                    "option": "bigcommerce"
                  },
                  {
                    "option": "wix"
                  },
                  {
                    "option": "squarespace"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Monthly revenue",
              "fieldType": "checkbox",
              "defaultValue": "$100k-500k",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under $10k"
                  },
                  {
                    "option": "$10k-50k"
                  },
                  {
                    "option": "$50k-100k"
                  },
                  {
                    "option": "$100k-500k"
                  },
                  {
                    "option": "$500k-1M"
                  },
                  {
