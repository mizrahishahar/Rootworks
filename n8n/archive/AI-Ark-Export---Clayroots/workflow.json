    {
      "id": "b38c1e58-28dd-4ed8-a7cb-e34ea1e73be3",
      "name": "AI-Ark Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        1344,
        368
      ],
      "parameters": {
        "formTitle": "AI-Ark Export -> Clayroots",
        "formDescription": "Upload an AI-Ark people-export CSV (Full Name, Title, Seniority, Email Business, Company Name, Company Website, etc). Contacts merge into the client's ClayRoots Contacts table by Contact Key. Company data for a domain already in the table is reused verbatim; a genuinely new domain gets its company data from DiscoLike, not from AI-Ark's own columns.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Clayroots Base ID",
              "placeholder": "appXXXXXXXXXXXXXX — from the Hub Clients table",
              "requiredField": true
            },
            {
              "fieldLabel": "Build name",
              "placeholder": "Names the build table — e.g. UK Ecom AI-Ark"
            },
            {
              "fieldLabel": "AI-Ark contacts CSV",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".csv",
              "requiredField": true
            },
            {
              "fieldLabel": "Domains Table ID",
              "placeholder": "tblXXXXXXXXXXXXXX — the client's Domains table, company data source of truth",
              "requiredField": true
            },
            {
              "fieldLabel": "Existing Table ID",
              "placeholder": "tblXXXXXXXXXXXXXX — leave empty to create a new table"
            },
            {
              "fieldLabel": "Tag",
              "placeholder": "Optional label for this build — written onto every row"
            }
          ]
        },
        "options": {
          "path": "aiark-contacts",
          "respondWithOptions": {
            "values": {
              "respondWith": "redirect",
              "redirectUrl": "=https://n8n.flowroots.com/workflow/{{ $workflow.id }}/executions/{{ $execution.id }}"
            }
          }
        }
      },
      "webhookId": "1b7b3f9e-3da2-4eab-b821-426ad6a24e08"
    },
