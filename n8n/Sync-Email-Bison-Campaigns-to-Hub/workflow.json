        "id": "de6d2a7c-c28d-409f-9971-46cda18d4ccd",
        "name": "Bison List Campaigns",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          400,
          -160
        ],
        "parameters": {
          "url": "https://send.nochileads.com/api/campaigns",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            },
            "pagination": {
              "pagination": {
                "paginationMode": "updateAParameterInEachRequest",
                "parameters": {
                  "parameters": [
                    {
                      "type": "qs",
                      "name": "page",
                      "value": "={{ ($response.body.meta && $response.body.meta.current_page ? $response.body.meta.current_page : 1) + 1 }}"
                    }
                  ]
                },
                "paginationCompleteWhen": "other",
                "completeExpression": "={{ !($response.body.links && $response.body.links.next) }}",
                "limitPagesFetched": true,
                "maxRequests": 20,
                "requestInterval": 300
              }
            }
          }
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "1cjIE7eXqZZ4r1Pm",
            "name": "Email Bison DuoDiv"
          }
        },
        "alwaysOutputData": true,
        "onError": "continueRegularOutput",
        "notes": "GET /api/campaigns on DuoDiv's instance, 15 to a page, every page (links.next empty ends it). The list already carries sent, contacted, unique replies, bounced, interested and status; no stats endpoint needed."
      },
      {
        "id": "f90d991f-c711-4196-b096-163ccb942756",
        "name": "Format Campaign Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          620,
          -160
        ],
        "parameters": {
          "jsCode": "// Format Campaign Rows: every page of GET /api/campaigns into Hub Campaigns rows, upserted on\n// Campaign ID. Bison's list already carries the client-facing numbers. Field by field:\n//   Leads = total_leads · Contacted = total_leads_contacted · Messages Sent = emails_sent\n//   Replies = unique_replies · Positive Replies (PV) = interested (the sequencer's own count)\n//   Bounced = bounced · Opens/Unique Opens = opened/unique_opens · Open Tracking = open_tracking\n//   Completed = total_leads x completion_percentage (Bison has no finished-leads count)\n//   Last Sent is not on Bison's list and stays blank.\nconst clientRecId=$('Parse Client').first().json.clientRecId||'';\nconst STATUS={ active:'ACTIVE', paused:'PAUSED', completed:'COMPLETED', draft:'DRAFT', archived:'STOPPED', stopped:'STOPPED' };\nconst raw=[];\nfor(const it of $input.all()){\n  const j=it.json||{};\n  const arr=Array.isArray(j)?j:(Array.isArray(j.data)?j.data:[]);\n  for(const c of arr){ if(c&&c.id) raw.push(c); }\n}\nif(!raw.length) return [{ json: { _keepAlive:true } }];\nconst num=(v)=>{ const n=Number(v); return Number.isFinite(n)?n:0; };\nreturn raw.map(c=>({ json: {\n  'Campaign': c.name||String(c.id),\n  'Campaign ID': String(c.id),\n  'Client': clientRecId?[clientRecId]:[],\n  'Sequencer':'Email Bison',\n  'Channel':'Email',\n  'Status': STATUS[String(c.status||'').toLowerCase()]||'',\n  'Leads': num(c.total_leads),\n  'Contacted': num(c.total_leads_contacted),\n  'Completed': Math.round(num(c.total_leads)*num(c.completion_percentage)/100),\n  'Messages Sent': num(c.emails_sent),\n  'Replies': num(c.unique_replies),\n  'Positive Replies (PV)': num(c.interested),\n  'Bounced': num(c.bounced),\n  'Opens': num(c.opened),\n  'Unique Opens': num(c.unique_opens),\n  'Open Tracking': !!c.open_tracking,\n  'Last Sent': '',\n  'Created': c.created_at||'',\n  'Last Synced': $now.toISO()\n}}));\n"
        },
        "alwaysOutputData": true,
        "onError": "continueRegularOutput"
      },
