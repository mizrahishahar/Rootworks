        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tbli7rV6Qf3sLpV6R"
        },
        "id": "={{ $json.recordId }}",
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "RZ2SX89iUyF4aEWJ",
          "name": "Airtable"
