{
  "actorSpecification": 1,
  "name": "fresh-service-complaints",
  "title": "Fresh Service Complaints",
  "description": "Trustpilot category feeds sorted by latest review -> fresh 1-2 star customer-service reviews for the stores that appeared. Output feeds Handle Service Reviews Intent Signal via the task webhook.",
  "version": "1.0",
  "buildTag": "latest",
  "input": {
    "title": "Fresh Service Complaints input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "categories": {
        "title": "Category URLs",
        "type": "array",
        "description": "Trustpilot category pages to read, one per market. sort=latest_review is appended automatically.",
        "editor": "stringList",
        "prefill": [
          "https://www.trustpilot.com/categories/clothing_store",
          "https://www.trustpilot.com/categories/cosmetics_store",
          "https://www.trustpilot.com/categories/furniture_store",
          "https://www.trustpilot.com/categories/electronics_store"
        ]
      },
      "feedPagesPerCategory": { "title": "Feed pages per category", "type": "integer", "default": 6 },
      "lookbackDays": { "title": "Lookback days", "type": "integer", "default": 2 },
      "stars": { "title": "Star ratings", "type": "array", "editor": "json", "default": [1, 2] },
      "topics": { "title": "Trustpilot topics", "type": "array", "editor": "json", "default": ["customer_service"] },
      "maxReviewsPerCompany": { "title": "Max reviews per company", "type": "integer", "default": 20 },
      "reviewBatchSize": { "title": "Review batch size (child actor caps at 10)", "type": "integer", "default": 10, "maximum": 10 },
      "childMaxChargeUsd": { "title": "Charge cap per child call (USD)", "type": "integer", "default": 1, "sectionCaption": "Cost controls" },
      "maxDomainsPerRun": { "title": "Max domains per run", "type": "integer", "default": 1000 }
    }
  }
}
