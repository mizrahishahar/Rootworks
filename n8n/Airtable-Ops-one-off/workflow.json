        "id": "d4000000-0000-4000-8000-000000000002",
        "name": "Split Fields",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "jsCode": "// One-off: add fields to a table through Airtable's meta API. Body: { base, table, fields:[{name,type,options?}] }.\n// Exists because the Airtable MCP cannot always reach the schema; the Airtable credential in n8n can.\nconst b=($input.first().json||{}).body||{};\nif(!b.base||!b.table||!Array.isArray(b.fields)||!b.fields.length) throw new Error('need base, table, fields[]');\nreturn b.fields.map(f=>({ json:{ base:b.base, table:b.table, field:f } }));\n"
        }
      },
