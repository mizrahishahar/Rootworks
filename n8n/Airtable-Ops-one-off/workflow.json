        "name": "Create Field",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          440,
          0
        ],
        "parameters": {
          "method": "POST",
          "url": "=https://api.airtable.com/v0/meta/bases/{{ $json.base }}/tables/{{ $json.table }}/fields",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "airtableTokenApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json.field }}",
          "options": {
            "batching": {
              "batch": {
                "batchSize": 1,
                "batchInterval": 300
              }
            },
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true
              }
            }
          }
        },
        "credentials": {
          "airtableTokenApi": {
