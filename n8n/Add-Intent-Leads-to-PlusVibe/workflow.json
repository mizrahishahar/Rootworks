      {
        "id": "764a6faa-a984-431f-805c-ebdef8da8957",
        "name": "Prep Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          700,
          -160
        ],
        "parameters": {
          "jsCode": "let tables=[]; try{ tables=$('Parse Client Config').all().map(i=>i.json).filter(t=>t&&t.baseId); }catch(e){}\nconst rows=$input.all();\nconst out=[];\nfor(const it of rows){\n  const j=it.json||{};\n  let src=null;\n  try{ const pi=it.pairedItem; const idx=(typeof pi==='number')?pi:(pi&&pi.item); if(idx!==undefined&&idx!==null) src=tables[idx]||null; }catch(e){}\n  if(!src && tables.length===1) src=tables[0];\n  if(!src) src=tables[0]||{};\n  if(j.error){ out.push({ json: { _readError:true, tableId:src.tableId||'', errorMessage:String((j.error&&(j.error.message||j.error))||'read failed').slice(0,160) } }); continue; }\n  if(!j.id) continue;\n  out.push({ json: { recordId:j.id, baseId:src.baseId||'', tableId:src.tableId||'', clientRecId:src.clientRecId||'', clientName:src.clientName||'', pvWorkspace:src.pvWorkspace||'', row:(j.fields||j) } });\n}\nreturn out;"
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "b0fac47c-0b13-4d93-b22a-860da0916c8b",
        "name": "Route Rows",
