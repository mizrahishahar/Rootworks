        "messageType": "block",
        "blocksUi": "={{ (function(){ var F=$('Flatten').first().json; var N=$('Normalize').first().json; var rawLead=$('PV Get Lead').first().json; var recL=Array.isArray(rawLead)?rawLead[0]:((rawLead&&rawLead.lead_data)?rawLead:((rawLead&&rawLead[0])||rawLead||{})); var dL=(recL&&recL.lead_data)?recL.lead_data:(recL||{}); var acct=String(dL.email_account_id||'').toLowerCase(); var prefix=(acct.split('@')[0]||'').replace(/\\.[a-z0-9]+$/,''); var pmap={tomwilson:'Tom Wilson',sarahjohnson:'Sarah Johnson',mikecarter:'Mike Carter',jakemiller:'Jake Miller'}; var persona=pmap[prefix]||'our rep'; var company=F.company_name||'Unknown'; var tz=F.custom_timezone||''; var zmap={ET:'America/New_York',CT:'America/Chicago',MT:'America/Denver',PT:'America/Los_Angeles',AT:'America/Halifax',AKT:'America/Anchorage',HT:'Pacific/Honolulu'}; var zone=zmap[tz]||'America/New_York'; var localTime=$now.setZone(zone).toFormat('cccc h:mma'); var first=(N.first_name||'').trim(); var who=first?first:'General inbox, confirm you have the owner'; var city=(N.city||'').trim(); var where=(city?city+', ':'')+tz+' · now '+localTime; var brief=(F.custom_qualification_brief||''); var fit=(brief.split('\\n')[0]||'').replace(/:?white_check_mark:?/gi,'').replace(/^[ |-]+/,'').trim().slice(0,180)||F.custom_qualification_status||''; var situation=(F.situation_summary||'').trim()||((F.reply_text||'').replace(/\\s+/g,' ').trim().slice(0,160))||'interested, see thread'; var phone=F.custom_phone||'(no number)'; var isBooking=(N.event_type==='booking'); var bookedRaw=N.booked_time||''; var bookedDisp=bookedRaw; try{ if(bookedRaw){ var bdt=DateTime.fromISO(bookedRaw,{zone:'utc'}).setZone(zone); if(bdt.isValid){ bookedDisp=bdt.toFormat('cccc LLL d, h:mma')+(tz?' '+tz:''); } } }catch(e){} var header=isBooking?('📅 Straight demo booked — '+company):('🔥 New Cold Email Lead to call — '+company); var standsLine=isBooking?('When: '+(bookedDisp||'see Calendly')):('Where it stands: '+situation); var goalLine=isBooking?'Booked straight off the cold email, no follow-up. It is on the calendar with Sam, confirm and prep.':'Goal: book the demo with Sam'; var tailLine=isBooking?'Reply in this thread as you work it — your notes sync back to our system.':'Reply in this thread as you work it (called / reached / following up) — your notes sync back to our system. I keep hitting them on email in parallel and will flag the moment I book one so you can stop, and same the other way.'; var text=header+'\\nWho: '+who+'\\nWhere: '+where+'\\n📞 '+phone+'\\nFit: '+fit+'\\n'+standsLine+'\\nWe email them as '+persona+' (so you are consistent if it comes up)\\n'+goalLine+'\\n'+tailLine; return JSON.stringify({ blocks:[ { type:'section', text:{ type:'mrkdwn', text:text.slice(0,2900) } } ] }); })() }}",
