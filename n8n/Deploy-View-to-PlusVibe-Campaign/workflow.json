          -1200,
          200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Open Deploy: the door's one entry, and the only place it names itself. The webhook is now the\n// ONLY way in (Operator ruling 2026-09-03): the daily feed lives in Airtable, as Schedule Live\n// View Deploys, which creates the launch rows and fires this webhook, so the scheduled and the\n// on-demand path are the same path by construction instead of by convention.\nconst b = ($input.first() || {}).json || {};\nconst recordId = String((b.body && b.body.recordId) || (b.query && b.query.recordId) || b.recordId || '').trim();\nreturn [{ json: {\n  mode: 'prepare',\n  sender: 'PlusVibe',\n  automation: 'Deploy View to PlusVibe Campaign',\n  execId: String($execution.id),\n  wfId: String($workflow.id),\n  recordId: recordId || 'recMISSING'\n} }];\n"
        }
      },
      {
        "id": "pvd-02-prepare",
        "name": "Prepare",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.3,
        "position": [
          -1000,
          200
        ],
        "parameters": {
          "workflowId": {
            "__rl": true,
            "mode": "id",
            "value": "VfjJGNlykzuZok2T",
            "cachedResultName": "Deploy View Prepare and Finish"
          },
          "workflowInputs": {
            "mappingMode": "passThrough",
            "value": {},
            "matchingColumns": [],
            "schema": []
          },
          "mode": "once",
          "options": {
            "waitForSubWorkflow": true
          }
        },
        "notes": "Mode prepare, awaited, error left to travel: resolves the launch row into client, base, campaign, mirror row, table, view and the field contract, drops DNC domains, applies the run cap and hands back the leads shaped as merge variables. A failure inside it fails this run, which is the run the Error Logger names."
      },
      {
        "id": "pvd-03-loadstate",
        "name": "Load State",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -800,
          200
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Load State: what prepare resolved becomes this run's state. It lives in static data for the\n// length of the send lane only, because the chunk loop's Wait is seconds long and keeps the\n// execution in memory; Close Deploy takes it back off and hands it to finish as data.\nconst sd = $getWorkflowStaticData('global'); const dk = 'deploy_' + $execution.id;\nconst p = ($input.first() || {}).json || {};\nconst D = p.state || {};\nsd[dk] = D;\nreturn [{ json: { ws: D.ws || 'none', ready: !!p.ready, abort: !!D.abort, body: p.body || null } }];\n"
        }
      },
      {
        "id": "b8b40765-2a4f-4985-9f8d-3d8cbe296e83",
