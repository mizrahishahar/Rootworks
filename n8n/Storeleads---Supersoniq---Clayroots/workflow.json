    {
      "parameters": {
        "url": "=https://storeleads.app/json/api/v1/{{ $json._provider }}/domain",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify(Object.fromEntries(Object.entries($json.pullQuery).filter(([k]) => k !== 'f:state'))) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "cursor",
                    "value": "={{ $response.body.next_cursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.has_next_page }}",
              "limitPagesFetched": true,
              "maxRequests": "={{ Math.min(Math.ceil(($json.maxCompanies || 500) / 50) + 2, 400) }}",
              "requestInterval": 1200
            }
          },
          "timeout": 60000
        }
      },
