{
  "id": "JuWIbF6YCeRibhyg",
  "name": "Deploy View to PlusVibe Campaign",
  "nodes": [
    {
      "id": "8e421b08-8ee3-4b04-a2c3-f51891a32363",
      "name": "Deploy Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1400, 200],
      "parameters": {
        "httpMethod": "POST",
        "path": "deploy-view-to-campaign",
        "responseMode": "onReceived"
      },
      "webhookId": "d4da1898-15df-47fa-800c-8bc358848ed6",
      "notes": "The door's ONLY entry (ruling 2026-09-03). The daily feed lives in Airtable now, as Schedule Live View Deploys, which creates the launch row and POSTs {recordId} here, so a scheduled deploy and a hand launch are the same run."
    },
    {
      "id": "pvd-01-open",
      "name": "Open Deploy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1200, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Open-Deploy.js"
      }
    },
    {
      "id": "pvd-02-prepare",
      "name": "Prepare",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [-1000, 200],
      "parameters": {
        "workflowId": { "__rl": true, "mode": "id", "value": "VfjJGNlykzuZok2T", "cachedResultName": "Deploy View Prepare and Finish" },
        "workflowInputs": { "mappingMode": "passThrough", "value": {}, "matchingColumns": [], "schema": [] },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      },
      "notes": "Mode prepare, awaited, error left to travel: resolves the launch row into client, base, campaign, mirror row, table, view and the field contract, drops DNC domains, applies the run cap and hands back the leads shaped as merge variables. A failure inside it fails this run, which is the run the Error Logger names."
    },
    {
      "id": "pvd-03-loadstate",
      "name": "Load State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Load-State.js"
      }
    },
    {
      "id": "b8b40765-2a4f-4985-9f8d-3d8cbe296e83",
      "name": "List PV Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-600, 200],
      "parameters": {
        "method": "GET",
        "url": "https://api.plusvibe.ai/api/v1/campaign/list-all",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "workspace_id", "value": "={{ $json.ws }}" },
            { "name": "limit", "value": "100" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "credentials": { "httpHeaderAuth": { "id": "mFWofPdYJXJU5ZwX", "name": "Plusvibe Admin" } },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "3f53a414-3fea-4c67-b0c5-fd58936a6e4a",
      "name": "Check PV Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Check-PV-Campaign.js"
      }
    },
    {
      "id": "630eb3ba-caa5-42de-b0dd-7252b93d6263",
      "name": "Ready to Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-200, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "lr1", "leftValue": "={{ $json.ready ? 'yes' : 'no' }}", "rightValue": "yes", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "No leads to send is not a failure: a refused launch and a view where every row was skipped both go straight to the close, which stamps the rows and writes the row."
    },
    {
      "id": "11197f97-4dd3-429f-b87d-2f257f1e0275",
      "name": "Send Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [0, 100],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.wait || 0 }}",
        "unit": "seconds"
      },
      "webhookId": "a31711c6-5390-47d2-8df2-1779e4a9b58e"
    },
    {
      "id": "e6b821ee-83cd-4028-acb7-23fbc450dcf0",
      "name": "PV Add Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [200, 100],
      "parameters": {
        "method": "POST",
        "url": "https://api.plusvibe.ai/api/v1/lead/add",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": { "response": { "neverError": true, "fullResponse": true } },
          "timeout": 120000
        }
      },
      "credentials": { "httpHeaderAuth": { "id": "mFWofPdYJXJU5ZwX", "name": "Plusvibe Admin" } },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "The one thing this door does that nothing else can: the bulk upload, 200 leads to a request."
    },
    {
      "id": "ff193c2f-8a41-4590-bea5-a9868d0416cd",
      "name": "Collect Send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 100],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Collect-Send.js"
      }
    },
    {
      "id": "d9570a98-fb94-49bd-8695-37b4ac1fcf1e",
      "name": "Send Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [600, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "sd1", "leftValue": "={{ $json.done ? 'done' : 'more' }}", "rightValue": "done", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5853c86c-c3fc-4eb6-ac93-170638da983f",
      "name": "Stamp Progress",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [600, -60],
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "appQG6dK0FIOhTxOl" },
        "table": { "__rl": true, "mode": "id", "value": "tbli7rV6Qf3sLpV6R" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["id"],
          "schema": [],
          "value": {
            "id": "={{ $json._lid }}",
            "Status": "Running",
            "Description": "={{ $json._prog }}"
          }
        },
        "options": { "typecast": true }
      },
      "credentials": { "airtableTokenApi": { "id": "RZ2SX89iUyF4aEWJ", "name": "Airtable" } },
      "notes": "Writes live upload progress onto the launch row after every chunk, so a long deploy is readable while it runs instead of only at the end. A SIDE branch of Collect Send: it must never sit between Collect Send and Send Done?, its Airtable output would destroy the loop state.",
      "onError": "stopWorkflow"
    },
    {
      "id": "af6555bb-ccac-47c8-89aa-a8e6b128433d",
      "name": "Init Readback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Init-Readback.js"
      }
    },
    {
      "id": "c490653e-d01d-4f88-9dbf-bdbad8d96861",
      "name": "RB Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1000, 200],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.wait || 0 }}",
        "unit": "seconds"
      },
      "webhookId": "8ee6cc76-6c47-4e79-adc7-9050c09ad705"
    },
    {
      "id": "1717a52b-0302-4f04-bd5d-a9f80c32aef3",
      "name": "Pull Campaign Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1200, 200],
      "parameters": {
        "method": "GET",
        "url": "https://api.plusvibe.ai/api/v1/lead/workspace-leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "workspace_id", "value": "={{ $json.ws }}" },
            { "name": "campaign_id", "value": "={{ $json.campaign_id }}" },
            { "name": "limit", "value": "100" },
            { "name": "page", "value": "={{ $json.page }}" }
          ]
        },
        "options": {
          "response": { "response": { "neverError": true, "fullResponse": true } },
          "timeout": 60000
        }
      },
      "credentials": { "httpHeaderAuth": { "id": "mFWofPdYJXJU5ZwX", "name": "Plusvibe Admin" } },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "95b35fde-179f-4b61-9273-6a674cfa10fc",
      "name": "Collect RB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Collect-RB.js"
      }
    },
    {
      "id": "b117045f-a074-41db-aa0b-666e0380a839",
      "name": "RB Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1600, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "rd1", "leftValue": "={{ $json.done ? 'done' : 'more' }}", "rightValue": "done", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "pvd-90-close",
      "name": "Close Deploy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Close-Deploy.js"
      }
    },
    {
      "id": "pvd-91-finish",
      "name": "Finish",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [2000, 200],
      "parameters": {
        "workflowId": { "__rl": true, "mode": "id", "value": "VfjJGNlykzuZok2T", "cachedResultName": "Deploy View Prepare and Finish" },
        "workflowInputs": { "mappingMode": "passThrough", "value": {}, "matchingColumns": [], "schema": [] },
        "mode": "once",
        "options": { "waitForSubWorkflow": true }
      },
      "notes": "Mode finish, awaited, error left to travel: stamps Deploy Error and the Campaigns links on the source rows, writes the Lead Lists receipt and writes this run's Hub row, upserted on this execution's id. A failed log write crashes it, and with it this run."
    }
  ],
  "connections": {
    "Deploy Webhook": { "main": [[{ "node": "Open Deploy", "type": "main", "index": 0 }]] },
    "Open Deploy": { "main": [[{ "node": "Prepare", "type": "main", "index": 0 }]] },
    "Prepare": { "main": [[{ "node": "Load State", "type": "main", "index": 0 }]] },
    "Load State": { "main": [[{ "node": "List PV Campaigns", "type": "main", "index": 0 }]] },
    "List PV Campaigns": { "main": [[{ "node": "Check PV Campaign", "type": "main", "index": 0 }]] },
    "Check PV Campaign": { "main": [[{ "node": "Ready to Send?", "type": "main", "index": 0 }]] },
    "Ready to Send?": {
      "main": [
        [{ "node": "Send Pace", "type": "main", "index": 0 }],
        [{ "node": "Close Deploy", "type": "main", "index": 0 }]
      ]
    },
    "Send Pace": { "main": [[{ "node": "PV Add Leads", "type": "main", "index": 0 }]] },
    "PV Add Leads": { "main": [[{ "node": "Collect Send", "type": "main", "index": 0 }]] },
    "Collect Send": {
      "main": [
        [
          { "node": "Send Done?", "type": "main", "index": 0 },
          { "node": "Stamp Progress", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Done?": {
      "main": [
        [{ "node": "Init Readback", "type": "main", "index": 0 }],
        [{ "node": "Send Pace", "type": "main", "index": 0 }]
      ]
    },
    "Init Readback": { "main": [[{ "node": "RB Pace", "type": "main", "index": 0 }]] },
    "RB Pace": { "main": [[{ "node": "Pull Campaign Leads", "type": "main", "index": 0 }]] },
    "Pull Campaign Leads": { "main": [[{ "node": "Collect RB", "type": "main", "index": 0 }]] },
    "Collect RB": { "main": [[{ "node": "RB Done?", "type": "main", "index": 0 }]] },
    "RB Done?": {
      "main": [
        [{ "node": "Close Deploy", "type": "main", "index": 0 }],
        [{ "node": "RB Pace", "type": "main", "index": 0 }]
      ]
    },
    "Close Deploy": { "main": [[{ "node": "Finish", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "gqm6HzVNzEMQ8Ml0"
  }
}
