      {
        "id": "a17ad00f-0000-4000-8000-000000000021",
        "name": "Prep Person",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2640,
          0
        ],
        "parameters": {
          "jsCode": "// Prep Person: the second read of a dossier. get_prospect answers ids only, so the person behind\n// the prospect is fetched by its personId. No personId means no second call and the door answers\n// what the prospect read gave.\nconst parse = (raw) => { try { let s = raw; if (typeof s === 'object' && s.data) s = s.data; if (typeof s !== 'string') s = JSON.stringify(s); const m = s.match(/data:\\s*(\\{[\\s\\S]*\\})/); const rpc = JSON.parse(m ? m[1] : s); const txt = rpc.result && rpc.result.content && rpc.result.content[0] && rpc.result.content[0].text; return txt ? (txt.startsWith('{') ? JSON.parse(txt) : txt) : null; } catch (e) { return null; } };\nconst p = parse($input.first().json) || {};\nconst personId = p.personId || '';\nif (!personId) return [];\nreturn [{ json: { callBody: { jsonrpc: '2.0', id: 2, method: 'tools/call', params: { name: 'get_person', arguments: { personId } } } } }];\n"
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "a17ad00f-0000-4000-8000-000000000022",
        "name": "MCP Person",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          2860,
          0
        ],
        "parameters": {
