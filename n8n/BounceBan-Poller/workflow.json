      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const r=$json; const res=r.result;\n// 2026-08-12: 'Email Source' replaces 'Source' (Operator ruling). And only a DEFINITIVE verdict may\n// touch the address columns: deliverable fills them, undeliverable clears them. risky / unknown /\n// error write only BB and Status - omitting the keys leaves the existing Final Email untouched.\nif(res==='deliverable'){ return { json:{ id:r.rowId, 'BB':res, 'Final Email':r.email, 'Email Source':r.slot, 'Status':'done' } }; }\nif(res==='undeliverable'){ return { json:{ id:r.rowId, 'BB':res, 'Final Email':'', 'Email Source':'none', 'Status':'no_email_found' } }; }\nif(res==='risky'||res==='unknown'){ return { json:{ id:r.rowId, 'BB':res, 'Status':'no_email_found' } }; }\nreturn { json:{ id:r.rowId, 'BB':'error', 'Status':'error' } };"
        },
        "id": "ccecd8cc-f92c-429f-9b49-0f10f77de248",
        "name": "Build Update",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1344,
          272
        ]
      },
      {
        "parameters": {
          "operation": "update",
