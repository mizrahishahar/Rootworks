  "id": "2qUsGJAQPCUmjCdb",
  "name": "HeyReach Ops (one-off)",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "hro-00-webhook",
      "name": "Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -800,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "heyreach-call",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "b4e1d2c3-7a8f-4b9e-9c1d-3e5f7a9b1c2d",
      "notes": "HQ's one door onto the HeyReach public API, per client. POST {client: rec..., method, path, query, body}. The key is read off the client's registry row inside this run and never travels through the caller. Kept for endpoint verification and one-off operations (stop a lead, list senders, read conversations)."
    },
    {
      "id": "hro-01-getclient",
      "name": "Get Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        -600,
        200
      ],
      "parameters": {
        "resource": "record",
        "operation": "get",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appQG6dK0FIOhTxOl"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblK0nCoNVvFf5SPa"
        },
        "id": "={{ $json.body.client }}",
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "RZ2SX89iUyF4aEWJ",
          "name": "Airtable"
        }
      },
      "notes": "The client's registry row: Clients.HeyReach API Key is the only field read."
    },
    {
      "id": "hro-02-build",
      "name": "Build Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Build-Call.js"
      }
    },
    {
      "id": "hro-02b-ok",
      "name": "Call OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -300,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok1",
              "leftValue": "={{ $json.ok ? \"yes\" : \"no\" }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "A refused call (no key, bad method or path) answers the caller directly and never reaches the HTTP node."
    },
    {
      "id": "hro-03-call",
      "name": "HeyReach Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -100,
        120
      ],
      "parameters": {
        "method": "={{ $json.method }}",
        "url": "={{ $json.url }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $json.hrKey }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": "={{ $json.sendBody }}",
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || {}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "timeout": 60000
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "X-API-KEY from the registry row, 300 requests a minute on HeyReach's side. neverError + fullResponse so the caller reads the real status and body."
    },
    {
      "id": "hro-04-compact",
      "name": "Compact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Compact.js"
      }
    }
  ],
  "connections": {
    "Call Webhook": {
      "main": [
        [
          {
            "node": "Get Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Client": {
      "main": [
        [
          {
            "node": "Build Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Call": {
      "main": [
        [
          {
            "node": "Call OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HeyReach Call": {
      "main": [
        [
          {
            "node": "Compact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call OK?": {
      "main": [
        [
          {
            "node": "HeyReach Call",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Compact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
