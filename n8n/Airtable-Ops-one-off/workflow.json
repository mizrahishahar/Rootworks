        "parameters": {
          "jsCode": "// Compact Rows: the list-records door's response. One object: { count, rows:[{id,...fields}] }.\nconst rows=[];\nfor(const it of $input.all()){\n  const j=it.json||{};\n  if(!j.id) continue;\n  rows.push(Object.assign({ id:j.id }, j.fields||j));\n}\nreturn [{ json: { count:rows.length, rows } }];\n"
