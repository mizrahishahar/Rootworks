      {
        "id": "a17ad00f-0000-4000-8000-000000000015",
        "name": "Alta Token Gate",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1320,
          0
        ],
        "parameters": {
          "jsCode": "// Alta Token Gate: the refreshed access token, or a refusal. Same shape the campaign sync uses:\n// the refresh token lives in the alta_oauth data table, the access token is minted per run and\n// never leaves n8n. A dead refresh token means the Operator re-authorizes through Alta OAuth Callback.\nconst t = $input.first().json || {};\nconst prev = $('Alta Get Token').first().json || {};\nconst req = $('Parse Request').first().json || {};\nconst access = t.access_token || '';\nif (!access) return [{ json: Object.assign({}, req, { _ok: false, _code: 502, ok: false, error: 'Alta OAuth refresh failed; the door cannot reach Alta until the refresh token is renewed', detail: JSON.stringify(t).slice(0, 300) }) }];\nreturn [{ json: Object.assign({}, req, { _ok: true, access_token: access, refresh_token: t.refresh_token || prev.refresh_token || '', expires_at: new Date(Date.now() + ((t.expires_in || 86400) * 1000)).toISOString() }) }];\n"
        },
        "onError": "continueRegularOutput"
      },
