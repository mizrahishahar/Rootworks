      {
        "id": "0630e8c5-0221-42ff-a4c3-085b04fa35ca",
        "name": "Record Outcome",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1280,
          -160
        ],
        "parameters": {
          "jsCode": "const sd=$getWorkflowStaticData('global');\nif(!Array.isArray(sd.pvSyncResults)) sd.pvSyncResults=[];\nlet clientRecId='', clientName='';\ntry{ const p=$('Parse Client').first().json; clientRecId=p.clientRecId||''; clientName=p.clientName||''; }catch(e){}\nlet rows=[]; try{ rows=$('Format Campaign Rows').all().map(i=>i.json).filter(r=>r&&r['Campaign ID']); }catch(e){}\nlet upserted=[]; try{ upserted=$('Upsert Campaigns').all().map(i=>i.json); }catch(e){}\nconst seen=rows.length;\nconst written=upserted.length;\nconst sent=rows.reduce((s,r)=>s+(r['Messages Sent']||0),0);\nconst replies=rows.reduce((s,r)=>s+(r['Replies']||0),0);\nconst positives=rows.reduce((s,r)=>s+(r['Positive Replies (PV)']||0),0);\nconst ok=!(seen>0 && written===0);\nsd.pvSyncResults.push({client:clientName||'(unknown)', clientRecId, campaigns:seen, written, sent, replies, positives, ok});\nreturn [{ json: { client:clientName||'', ok } }];"
        },
        "executeOnce": true,
        "onError": "continueRegularOutput"
      },
