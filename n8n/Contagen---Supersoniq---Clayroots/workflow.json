    {
      "parameters": {
        "formTitle": "Waterfall Contacts — ContaGen → Supersoniq",
        "formDescription": "Upload a ContaGen contacts CSV. Its contacts load as Source 1; Supersoniq then pulls every decision-maker (Manager and up, plus unclassified titles) at the same domains - no seniority or department picker, targeting is fixed on purpose. Both upsert into the client's ClayRoots build table.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Clayroots Base ID",
              "placeholder": "appXXXXXXXXXXXXXX — from the Flowroots CRM",
              "requiredField": true
            },
            {
              "fieldLabel": "Build name",
              "placeholder": "e.g. B2B SaaS 11-50 US"
            },
            {
              "fieldLabel": "ContaGen contacts CSV",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".csv",
              "requiredField": true
            },
            {
              "fieldLabel": "Contact location",
              "fieldType": "checkbox",
              "defaultValue": "United States",
              "fieldOptions": {
                "values": [
                  {
                    "option": "United States"
                  },
                  {
                    "option": "Israel"
                  },
                  {
                    "option": "United Kingdom"
                  },
                  {
                    "option": "Canada"
                  },
                  {
                    "option": "Australia"
                  },
                  {
                    "option": "Germany"
                  },
                  {
                    "option": "France"
                  },
                  {
                    "option": "Netherlands"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Existing Table ID",
              "placeholder": "tblXXXXXXXXXXXXXX — leave empty to create a new table"
            },
            {
              "fieldLabel": "Tag",
              "placeholder": "Optional label for this build — written onto every row"
            }
          ]
        },
        "options": {
          "path": "contagen-supersoniq",
          "respondWithOptions": {
            "values": {
              "respondWith": "redirect",
              "redirectUrl": "=https://n8n.flowroots.com/workflow/jJTD9xgbA0kKYqna/executions/{{ $execution.id }}"
            }
          }
        }
      },
