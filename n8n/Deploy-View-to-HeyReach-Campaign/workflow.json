            {
              "name": "X-API-KEY",
              "value": "={{ $(\"Load State\").first().json.hrKey }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "timeout": 120000
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "100 leads to a request (HeyReach allows more; kept small so a refused chunk is small). Answers counts only: added, updated, failed. Which rows failed is decided by the read-back."
    },
