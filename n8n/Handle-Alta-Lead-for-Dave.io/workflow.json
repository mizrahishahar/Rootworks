    {
      "id": "01bc507b-8699-4de0-b527-9b3b2526b40a",
      "name": "Screen Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1100,
        -200
      ],
      "parameters": {
        "promptType": "define",
        "text": "=REPLY (via Alta, {{ $('Alta Normalize').first().json.reply_channel }}), from {{ $('Alta Normalize').first().json.full_name }} at {{ $('Alta Normalize').first().json.company_name }}:\n\n{{ $('Alta Normalize').first().json.reply_text }}\n\nClassify it. Output JSON only.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You classify a prospect's reply to cold outreach. Output JSON only, one field: verdict.\n\nverdict = INTERESTED when the reply shows any openness: questions, curiosity, timing interest (even 'maybe later this quarter'), asks for more info, booking talk, or forwarding to a SPECIFIC named person with a door open.\nverdict = PASS when they clearly decline: not interested, we are good, stop reaching out, unsubscribe, remove me, a firm no with no door open - AND ALSO when the person says they left the company or are no longer the right person, unless they hand over a specific named colleague to continue with. A polite sign-off like 'best of luck' or 'let me know if you have questions' does NOT make a pass interested.\nverdict = AUTO for out-of-office and automated replies.\n\nWhen otherwise uncertain, choose INTERESTED - a human reviews everything downstream, and losing a real lead costs more than reviewing a pass."
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "701804b7-3173-43ff-a0f2-afa2ee7e3b96",
