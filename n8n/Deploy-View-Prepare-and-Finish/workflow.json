        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Route-Mode.js"
      }
    },
    {
      "id": "dvpf-02-mode",
      "name": "Which Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1000,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "wm1",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "prepare",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
