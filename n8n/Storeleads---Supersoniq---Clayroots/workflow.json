              "fieldLabel": "Clayroots Base ID",
              "placeholder": "appXXXXXXXXXXXXXX — from the Hub Clients table",
              "requiredField": true
            },
            {
              "fieldLabel": "Build name",
              "placeholder": "Names the build table and sheets — e.g. Shopify DTC 100k+ US",
              "requiredField": true
            },
            {
              "fieldLabel": "Country",
              "fieldType": "checkbox",
              "defaultValue": "United States",
              "fieldOptions": {
                "values": [
                  {
                    "option": "United States"
                  },
                  {
                    "option": "United Kingdom"
                  },
                  {
                    "option": "Canada"
                  },
                  {
                    "option": "Australia"
                  },
                  {
                    "option": "Ireland"
                  },
                  {
                    "option": "Israel"
                  },
