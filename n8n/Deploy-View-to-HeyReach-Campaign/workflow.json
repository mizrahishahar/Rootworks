    {
      "id": "hrd-02-prepare",
      "name": "Prepare",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        -1200,
        200
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "VfjJGNlykzuZok2T",
          "cachedResultName": "Deploy View Prepare and Finish"
        },
        "workflowInputs": {
          "mappingMode": "passThrough",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "notes": "Mode prepare, awaited, error left to travel: resolves the launch row into client (and its HeyReach API Key), base, campaign, mirror row, table, view and the field contract, drops DNC domains, applies the run cap and hands back the leads shaped for AddLeadsToCampaignV2 in 100-lead chunks. A failure inside it fails this run, which is the run the Error Logger names."
    },
    {
      "id": "hrd-03-loadstate",
      "name": "Load State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Load-State.js"
      }
    },
    {
      "id": "hrd-04-getcamp",
      "name": "Get HR Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -800,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.heyreach.io/api/public/campaign/GetById?campaignId=\" + $json.target }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $(\"Load State\").first().json.hrKey }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "timeout": 60000
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Proves the campaign exists in the client's workspace and reads its name, status and senders. X-API-KEY from the registry via Load State."
    },
    {
      "id": "hrd-05-checkcamp",
      "name": "Check HR Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "@@file:nodes/Check-HR-Campaign.js"
      }
    },
    {
      "id": "hrd-06-ready",
      "name": "Ready to Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -400,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "lr1",
              "leftValue": "={{ $json.ready ? \"yes\" : \"no\" }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "No leads to send is not a failure: a refused launch and a view where every row was skipped both go straight to the close, which stamps the rows and writes the row."
    },
    {
      "id": "hrd-07-pace",
      "name": "Send Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -200,
        100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.wait || 0 }}",
        "unit": "seconds"
      },
      "webhookId": "9d3e5f7a-2b4c-4d6e-8f0a-1b2c3d4e5f60"
    },
    {
