        "operation": "update",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appQG6dK0FIOhTxOl"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tbli7rV6Qf3sLpV6R"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ],
          "schema": [],
          "value": {
            "id": "={{ $json.id }}",
            "Status": "Running",
            "Execution ID": "={{ $('Route Mode').first().json.execId }}",
            "Execution Link": "=https://n8n.flowroots.com/workflow/{{ $('Route Mode').first().json.wfId }}/executions/{{ $('Route Mode').first().json.execId }}"
          }
        },
        "options": {
          "typecast": true
        }
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "RZ2SX89iUyF4aEWJ",
          "name": "Airtable"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Claims the launch row for this run on the CALLER's execution id, which is what finish upserts on. It never gates: a launch id that resolves to nothing must reach Init Deploy so the refusal is named on a row instead of crashing nameless."
